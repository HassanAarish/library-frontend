# LibraryHub frontend — copy to .env and adjust.
# Only VITE_* variables reach the browser; never put secrets here.

# Backend API (and Socket.IO, unless VITE_SOCKET_URL is set)
VITE_API_URL=http://localhost:5001
# VITE_SOCKET_URL=http://localhost:5001

# Social sign-in (public identifiers; leave empty to hide the button)
VITE_GOOGLE_CLIENT_ID=<google-oauth-client-id>
VITE_FACEBOOK_APP_ID=<facebook-app-id>

# Public site address (canonical links, social previews), no trailing slash
VITE_SITE_URL=https://<your-domain>

# Support contact shown on /contact and in the legal pages
VITE_SUPPORT_EMAIL=support@libraryhub.pk
# WhatsApp number in international format without "+", e.g. 923001234567 (empty hides it)
VITE_SUPPORT_WHATSAPP=03020217897

# Android App Links (website links open the LibraryHub app). Build-time only, not
# sent to the browser. The app's SHA-256 signing-certificate fingerprints, comma-
# separated: `eas credentials` (Android) and Play Console > App signing. They are
# public by design (served in /.well-known/assetlinks.json). Empty: no file.
# ANDROID_CERT_FINGERPRINTS=AB:CD:...
# ANDROID_PACKAGE=pk.libraryhub.app
