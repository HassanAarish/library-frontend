# LibraryHub frontend — copy to .env and adjust.
# Only VITE_* variables reach the browser; never put secrets here.

# Backend API (and Socket.IO, unless VITE_SOCKET_URL is set)
VITE_API_URL=http://localhost:5001
# VITE_SOCKET_URL=http://localhost:5001

# Social sign-in (public identifiers; leave empty to hide the button)
VITE_GOOGLE_CLIENT_ID=<google-oauth-client-id>
VITE_FACEBOOK_APP_ID=<facebook-app-id>
