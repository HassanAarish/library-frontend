    "formik": "^2.4.9",
    "moment": "^2.31.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.5",
    "react-toastify": "^11.1.0",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.3",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
